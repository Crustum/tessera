{
    "name": "crustum/tessera",
    "description": "OAuth2 server and API authentication for CakePHP — Crustum Tessera",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "oauth",
        "oauth2",
        "tessera",
        "passport",
        "api",
        "authentication"
    ],
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "cakephp/authentication": "^3.0",
        "cakephp/cakephp": "^5.0",
        "crustum/plugin-manifest": "^1.0",
        "firebase/php-jwt": "^6.4|^7.0",
        "league/oauth2-server": "^9.2",
        "php-http/discovery": "^1.20",
        "phpseclib/phpseclib": "^3.0",
        "psr/http-factory-implementation": "*",
        "symfony/psr-http-message-bridge": "^7.1|^8.0"
    },
    "require-dev": {
        "cakephp/bake": "^3.0",
        "cakephp/migrations": "^4.0|^5.0",
        "cakephp/cakephp-codesniffer": "^5.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.5.0",
        "rector/rector": "^2.5",
        "vierge-noire/cakephp-fixture-factories": "^3.0"
    },
    "suggest": {
        "cakephp/authorization": "Host permission rules for OAuth consent / protected routes",
        "cakedc/users": "Optional host users plugin"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Tessera\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestApp\\": "tests/TestApp/",
            "Crustum\\Tessera\\Test\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=TestCase",
        "test:feature": "phpunit --testsuite=TestCase",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse",
        "stan-baseline": "phpstan analyse --generate-baseline"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": false
        },
        "platform-check": false
    }
}
